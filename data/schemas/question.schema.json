{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eiken training question",
  "type": "object",
  "required": ["schemaVersion", "id", "grade", "skill", "part", "questionType", "sourceType", "difficulty", "tags"],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1"] },
    "id": { "type": "string", "pattern": "^(G5|G4|G3|GP2|GP2PLUS|G2|GP1|G1|P2|P2P|P1)-(R|L|W|S|V)-(P[0-9]+|LEGACY)-[0-9]{4}$" },
    "grade": { "enum": ["g5", "g4", "g3", "p2", "p2plus", "g2", "p1", "g1"] },
    "skill": { "enum": ["reading", "listening", "writing", "speaking", "vocabulary"] },
    "part": { "type": "string", "pattern": "^(P[0-9]+|LEGACY)$" },
    "questionType": { "type": "string", "minLength": 1 },
    "prompt": { "type": ["string", "null"] },
    "choices": { "type": "array", "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "text": { "type": "string" }, "image": { "type": ["string", "null"] } } } },
    "correctChoiceId": { "type": "string", "minLength": 1, "description": "For choice questions, the permanent ID of the correct choice." },
    "answer": { "type": "object", "properties": { "correctChoiceId": { "type": "string" }, "correctTokenOrder": { "type": "array", "items": { "type": "string" } } } },
    "explanation": { "type": "string" },
    "translation": { "type": ["string", "null"] },
    "script": { "type": ["string", "null"] },
    "difficulty": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sourceType": { "enum": ["original", "official-reference", "official-reference-analysis", "legacy", "unknown"] },
    "sourceReference": { "type": ["string", "null"] },
    "source": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["original", "official-reference", "official-reference-analysis", "legacy", "unknown"] }, "reference": { "type": ["string", "null"] } } },
    "reviewStatus": { "enum": ["pending", "structure-reviewed", "content-reviewed", "approved", "rejected"] },
    "modeEligibility": { "type": "array", "items": { "enum": ["practice", "official-style", "mock"] } },
    "payload": { "type": "object", "description": "Skill-specific fields." },
    "media": { "type": "object", "properties": { "assetType": { "enum": ["shared-scene", "question-specific", "none"] }, "audioRef": { "type": ["string", "null"] }, "imageRef": { "type": ["string", "null"] }, "audio": { "type": ["object", "null"], "properties": { "assetPath": { "type": "string" }, "playbackCount": { "type": "integer", "minimum": 1 } } }, "image": { "type": ["object", "null"], "properties": { "assetPath": { "type": "string" }, "alt": { "type": "string" } } } } }
  }
}
